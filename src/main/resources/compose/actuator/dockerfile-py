# ========== 阶段1：Python 环境构建 ==========
FROM python:3.7-slim AS python-env
# 显式设置工作目录
WORKDIR /python-build
# 复制Python工具包（默认root权限，不额外限制）
COPY python-tools/ /python-build/python-tools/
# 安装工具包到Python系统目录+清理缓存
RUN cd /python-build/python-tools/ && pip install --no-cache-dir . \
    && rm -rf /root/.cache/pip

# ========== 阶段2：Java + Python 整合（宽松权限+功能完整） ==========
FROM openjdk:8

# 1. 创建logs目录，使用777宽松权限（不考虑最小权限）
RUN mkdir -p /logs && chmod 777 /logs

# 2. 复制Python环境（从python-env阶段），确保Python可用
COPY --from=python-env /usr/local/ /usr/local/
# 建立Python软链接，确保全局可调用
RUN ln -s /usr/local/bin/python3.9 /usr/bin/python \
    && ln -s /usr/local/bin/pip3.9 /usr/bin/pip

# 3. 复制Java应用文件（默认root权限，不指定chown）
COPY actuator.jar logback-spring.xml startActuator.sh  ./
COPY config/bootstrap.yml ./config/

# 4. 设置Java相关文件权限（保留基础执行/只读，不做最小权限限制）
RUN chmod +x ./startActuator.sh \
    && chmod 644 ./actuator.jar ./config/bootstrap.yml ./logback-spring.xml

# 暴露端口
EXPOSE 18093

CMD ["./startActuator.sh"]