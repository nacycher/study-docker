FROM openjdk:8 AS java-base

FROM python:3.7-slim AS python-base
RUN if [ ! -f /usr/local/bin/python ]; then ln -s /usr/local/bin/python3 /usr/local/bin/python; fi \
    && if [ ! -f /usr/local/bin/pip ]; then ln -s /usr/local/bin/pip3 /usr/local/bin/pip; fi

FROM python:3.7-slim

# 复制Java环境 + 配置环境变量（纯镜像内复制，无网络）
COPY --from=java-base /usr/local/openjdk-8 /usr/local/openjdk-8
ENV JAVA_HOME=/usr/local/openjdk-8
ENV PATH=$JAVA_HOME/bin:$PATH

# 离线安装Python包（纯本地COPY+离线安装，无任何网络操作）
COPY ./pip_packages /usr/local/pip_packages
RUN pip install --no-index --find-links=/usr/local/pip_packages -r /usr/local/pip_packages/requirements.txt \
    && rm -rf /usr/local/pip_packages /root/.cache/pip

# 提前创建目录
RUN mkdir -p /spp/config /spp/logs && chmod 777 /spp/logs

# 复制应用文件（本地COPY，无网络）
COPY actuator.jar logback-spring.xml startActuator.sh  /spp/
COPY config/bootstrap.yml /spp/config/

# 脚本执行权限
RUN chmod +x /spp/startActuator.sh \
    && chmod 644 /spp/actuator.jar /spp/config/bootstrap.yml /spp/logback-spring.xml

EXPOSE 18093
CMD ["/spp/startActuator.sh"]